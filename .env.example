# Supabase project settings (Project Settings → API in the Supabase dashboard)

# Safe to expose in the browser — used by the client-side Supabase SDK.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY. Never prefix this with NEXT_PUBLIC_ and never commit a real
# value. It bypasses Row Level Security and is used only in lib/supabase/admin.ts
# for admin-only reads/writes, always after requireAdmin() has verified the
# caller server-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
